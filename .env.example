# Gestão Financeira — Variáveis de Ambiente

# Servidor
HOST=127.0.0.1
PORT=3333

# Banco de Dados PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/gestao_financeira
DATABASE_MAX_CONNECTIONS=10
# Usado pelo docker-compose.yml para inicializar o banco local.
POSTGRES_PASSWORD=DEFINA_UMA_SENHA_LOCAL_FORTE

# JWT
JWT_SECRET=TROQUE_POR_UMA_CHAVE_SEGURA_COM_PELO_MENOS_32_CARACTERES
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Assistente IA (Google Gemini)
GEMINI_API_KEY=SUA_CHAVE_DO_GEMINI_AQUI
GEMINI_MODEL=gemini-2.5-flash-lite

# CORS — Origem permitida para requisições do frontend.
# Use "*" para permitir qualquer origem (desenvolvimento) ou
# uma URL específica para produção (ex: https://meuapp.com).
CORS_ORIGIN=*

# Logs
RUST_LOG=gestao_financeira=debug,tower_http=debug
