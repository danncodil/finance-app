{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            a.id, a.name, a.description, a.icon_slug, a.xp_reward, \n            a.rule_type, a.rule_value, ua.unlocked_at\n        FROM achievements a\n        INNER JOIN user_achievements ua ON a.id = ua.achievement_id\n        WHERE ua.user_id = $1\n        ORDER BY ua.unlocked_at DESC\n        ",
